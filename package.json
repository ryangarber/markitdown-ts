{
  "name": "@ryangarber/markitdown-ts",
  "version": "0.2.1",
  "description": "Convert various file formats to Markdown for indexing, text analysis, and other applications that benefit from structured text. Node-free fork of the TypeScript fork of the original Python library.",
  "keywords": [
    "markdown",
    "converter",
    "browser",
    "uint8array",
    "docx",
    "pdf",
    "xlsx",
    "pptx",
    "zip"
  ],
  "homepage": "https://github.com/ryangarber/markitdown-ts#readme",
  "bugs": {
    "url": "https://github.com/ryangarber/markitdown-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryangarber/markitdown-ts.git"
  },
  "license": "MIT",
  "author": "Ryan Garber",
  "contributors": [
    "Vaibhav Raj"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "cli": "node ./src/cli.ts",
    "build": "tsdown && pnpm man",
    "build:cli": "node ./scripts/build.ts",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "man": "node ./scripts/man.ts"
  },
  "bin": {
    "markitdown": "./dist/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jvmr/pptx-to-html": "^1.1.2",
    "@optique/core": "^1.3.6",
    "@optique/man": "^1.3.6",
    "@optique/run": "^1.3.6",
    "@truto/turndown-plugin-gfm": "^1.0.5",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "file-type": "^22.2.0",
    "linkedom": "0.18.13",
    "mammoth": "^1.13.0",
    "mime": "^4.1.1",
    "read-excel-file": "^9.3.12",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "knip": "^6.42.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "26.12.1",
        "onFail": "download"
      },
      {
        "name": "bun",
        "version": ">=1.4.0",
        "onFail": "download"
      }
    ]
  },
  "man": "./dist/markitdown.1"
}
